# Supabase project (Project Settings > API Keys). The anon/publishable key is public by design:
# data is protected by Row Level Security in the database, not by this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Password shared by the demo accounts (ops@tenant7.test, ops@tenant12.test)
VITE_DEMO_PASSWORD=
